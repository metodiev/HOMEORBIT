# HomeOrbit environment
# Copy to `.env.local` for development, or set these in the service manager /
# container environment on the Mac Studio. Never commit real secrets.

# --- Database ---------------------------------------------------------------
# Absolute or relative path to the SQLite file. Defaults to ./data/homeorbit.db
# HOMEORBIT_DB_PATH=./data/homeorbit.db

# --- Sessions ---------------------------------------------------------------
# Defaults to true in production. Only set false for a trusted, isolated LAN
# without HTTPS. Remote access must use HTTPS through a VPN or gateway.
# SESSION_COOKIE_SECURE=true

# --- Local model server (Ollama) --------------------------------------------
# Keep Ollama bound to 127.0.0.1 (or the private LAN) and never expose 11434.
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.1:8b
# OLLAMA_VISION_MODEL=llama3.2-vision:11b
# OLLAMA_EMBED_MODEL=nomic-embed-text
# Only needed when Ollama itself is protected by a reverse proxy:
# OLLAMA_API_KEY=

# --- Optional external OpenAI-compatible provider --------------------------
# Local Ollama is preferred in "auto" mode. An external key is only used when
# the member selects it or no local model is configured. External responses are
# labelled in the UI and will receive the conversation content.
# AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
# AI_API_KEY_HEADER=api-key
# AI_JSON_MODE=false

# --- ComfyUI (local image generation/editing) ------------------------------
# ComfyUI must stay on localhost or a private network. HomeOrbit talks to it
# server-side only; the browser never receives this URL.
# COMFYUI_URL=http://127.0.0.1:8188
# COMFYUI_TIMEOUT_SECONDS=300
# Default checkpoint filename exactly as it appears in ComfyUI/models/checkpoints
# COMFYUI_CHECKPOINT=sd_xl_base_1.0.safetensors
# COMFYUI_MODEL=

# --- Media storage ----------------------------------------------------------
# Root for originals and generated/edited results. Back this folder up with the DB.
# MEDIA_STORAGE_PATH=./data/media
# MEDIA_MAX_UPLOAD_MB=25
# MEDIA_QUOTA_MB=2048
# MEDIA_RETENTION_DAYS=30

# --- Authorized internet research ------------------------------------------
# Use a household SearXNG instance (recommended, private) or a Brave Search key.
# Without one, web research tools report "not configured" instead of guessing.
# SEARXNG_URL=http://127.0.0.1:8080
# BRAVE_SEARCH_API_KEY=

# --- Real movie data (TMDB) -------------------------------------------------
# Create a free TMDB account and use a v4 read access token (preferred) or a v3 key.
# No title or streaming availability is invented when this is unset.
# TMDB_READ_TOKEN=
# TMDB_API_KEY=
# TMDB_REGION=BG
# TMDB_LANGUAGE=en-US

# --- Monitoring and scheduled jobs -----------------------------------------
# Required for detailed GET /api/health from a monitor without a browser session.
# HEALTH_CHECK_TOKEN=change-me-to-a-long-random-value
# Required by POST /api/proactive/run when called from cron without a session.
# PROACTIVE_SECRET=change-me-to-a-long-random-value

# --- External integrations (NOT configured by default) ---------------------
# Nothing below is used by the current release; setting them does not enable
# syncing by itself. See README → Integrations.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# IMAP_HOST=
# IMAP_USER=
# IMAP_PASSWORD=
# WEB_PUSH_PUBLIC_KEY=
# WEB_PUSH_PRIVATE_KEY=
# TELEGRAM_BOT_TOKEN=
# WHATSAPP_TOKEN=
