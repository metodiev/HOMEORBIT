# HomeOrbit environment
# Copy to `.env.local` (development) or set in your deployment platform.
# Never commit real secrets.

# --- Database ---------------------------------------------------------------
# Absolute or relative path to the SQLite file. Defaults to ./data/homeorbit.db
# HOMEORBIT_DB_PATH=./data/homeorbit.db

# --- AI provider (optional) -------------------------------------------------
# HomeOrbit works without an AI key using its built-in deterministic assistant.
# Any OpenAI-compatible chat-completions endpoint works: OpenAI, Azure OpenAI,
# OpenRouter, Ollama, LM Studio, vLLM, etc.
# AI_API_KEY=sk-...
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# Example: local Ollama (no key required by most setups, but the client expects one)
# AI_API_KEY=ollama
# AI_BASE_URL=http://127.0.0.1:11434/v1
# AI_MODEL=llama3.1:8b

# --- Scheduled jobs ---------------------------------------------------------
# Required by POST /api/proactive/run when called from cron without a session.
# PROACTIVE_SECRET=change-me-to-a-long-random-value

# --- External integrations (NOT configured by default) ----------------------
# These are placeholders for the documented integration work. Nothing below is
# used by the current release; setting them does not enable syncing by itself.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# IMAP_HOST=
# IMAP_USER=
# IMAP_PASSWORD=
# WEB_PUSH_PUBLIC_KEY=
# WEB_PUSH_PRIVATE_KEY=
# TELEGRAM_BOT_TOKEN=
# WHATSAPP_TOKEN=
