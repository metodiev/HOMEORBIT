{
  "name": "homeorbit",
  "version": "1.0.0",
  "private": true,
  "description": "HomeOrbit — your family's AI assistant",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/reset.ts",
    "proactive:run": "tsx scripts/proactive.ts",
    "media:purge": "tsx scripts/media-purge.ts",
    "backup": "tsx scripts/backup.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "mobile:sync": "cap sync",
    "mobile:copy": "cap copy",
    "mobile:android": "cap open android",
    "mobile:ios": "cap open ios",
    "mobile:assets": "capacitor-assets generate --android --ios --iconBackgroundColor \"#0b4f49\" --iconBackgroundColorDark \"#0b4f49\" --splashBackgroundColor \"#0b4f49\" --splashBackgroundColorDark \"#0b4f49\" --logoSplashScale 0.22",
    "system:start": "node scripts/start-web.mjs",
    "system:stop": "node scripts/stop-web.mjs",
    "android:start": "node scripts/start-android.mjs",
    "android:stop": "node scripts/stop-android.mjs",
    "ios:start": "node scripts/start-ios.mjs",
    "ios:stop": "node scripts/stop-ios.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "better-sqlite3": "^11.10.0",
    "jsqr": "^1.4.0",
    "next": "^15.5.28",
    "qrcode": "^1.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
